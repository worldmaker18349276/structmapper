#include "structmapper/schema_generator.hpp"
@STRUCTMAPPER_GEN_INCLUDES@

int main(int argc, char** argv)
{
    if (argc < 2)
    {
        std::cerr << "usage: " << argv[0] << " <schema_out_dir>\n";
        return 1;
    }
    return structmapper::generate_schemas<@STRUCTMAPPER_GEN_TYPES@>(argv[1]) ? 0 : 1;
}